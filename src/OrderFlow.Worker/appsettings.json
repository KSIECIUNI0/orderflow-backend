{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AWS": {
    "ServiceUrl": "http://localstack:4566",
    "Region": "us-east-1",
    "AccessKey": "test",
    "SecretKey": "test"
  },
  "Sqs": {
    "OrderCreatedQueueName": "order-created-queue",
    "OrderCreatedQueueUrl": "http://localstack:4566/000000000000/order-created-queue",
    "OrderCreatedDlqQueueUrl": "http://localstack:4566/000000000000/order-created-queue-dlq",
    "MaxNumberOfMessages": 10,
    "WaitTimeSeconds": 10,
    "VisibilityTimeout": 60
  },
  "S3": {
    "FailureStore": {
      "BucketName": "orderflow-failures",
      "Prefix": "dlq"
    }
  },
  "AlertService": {
    "Host": "http://orderflow-alertservice:8080"
  }
}
