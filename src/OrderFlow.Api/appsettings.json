{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Username=orderflow;Password=orderflow;Database=orderflow"
  },
  "AWS": {
    "ServiceURL": "http://localhost:4566",
    "AccessKey": "test",
    "SecretKey": "test"
  },
  "Sqs": {
    "MaxNumberOfMessages": 10,
    "WaitTimeSeconds": 10,
    "VisibilityTimeout": 60
  },
  "Queues": {
    "OrderCreated": {
      "Url": "http://localstack:4566/000000000000/order-created-queue"
    },
    "OrderCreatedDlq": {
      "Url": "http://localstack:4566/000000000000/order-created-queue-dlq"
    }
  },
  "S3FailureStore": {
    "BucketName": "orderflow-failures",
    "Prefix": "dlq",
    "MaxDegreeOfParallelism": 10,
    "MaxPageSize": 50
  },
  "AlertService": {
    "Host": "http://orderflow-alertservice:8080"
  },
  "OrderFlow": {
    "Metrics": {
      "OrderCreationDurationBuckets": [
        0.005,
        0.01,
        0.025,
        0.05,
        0.1,
        0.25,
        0.5,
        1,
        2.5,
        5
      ]
    }
  }
}
