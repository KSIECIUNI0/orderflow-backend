@host = http://localhost:5270
@orderId = 91cf6983-17d7-4ef6-80d7-cc499108564d

### Create Order
POST {{host}}/api/orders
Content-Type: application/json

{
  "productName": "Pepsi Zero",
  "quantity": 1
}

### Get all orders
GET {{host}}/api/orders
Content-Type: application/json

### Get by Id
GET {{host}}/api/orders/{{orderId}}
Content-Type: application/json

### Update order
PUT {{host}}/api/orders/{{orderId}}
Content-Type: application/json

{
  "productName": "Fanta",
  "quantity": 99
}

### Delete order
DELETE {{host}}/api/orders/{{orderId}}